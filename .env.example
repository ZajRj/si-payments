# Copia este archivo a .env antes de ejecutar docker compose.

# Obligatorio, mínimo 32 caracteres. Genéralo con: openssl rand -hex 32
JWT_SECRET=

# Contraseña de los usuarios de prueba que crea el seed.
# Si se deja vacía, el seed solo carga roles y permisos, sin usuarios.
SEED_USER_PASSWORD=Demo1234!

# Puerto de la aplicación en el host.
FRONTEND_PORT=8083
BACKEND_PORT=3003

# Ponlo en true cuando el sistema se sirva por HTTPS.
COOKIE_SECURE=false
